# Cloudflare Pages — never let the CDN pin the SW or env past a deploy.
# moc-phone.css and the hashed MOC bundle are edited in place (no Vite
# rename). If they stay max-age=14400, leftover HUD fixes sit on origin
# while 390 still paints the old chips / credits / INSTALL overlap.
/sw.js
  Cache-Control: no-cache
/mesh/sw.js
  Cache-Control: no-cache
/env.js
  Cache-Control: no-cache
/mesh/env.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/mesh/manifest.json
  Cache-Control: no-cache
/pwa-install.js
  Cache-Control: no-cache
/moc-phone.css
  Cache-Control: no-cache
/assets/index-B5yAHF7-.js
  Cache-Control: no-cache
/mesh/app.js
  Cache-Control: no-cache
/mesh/index.html
  Cache-Control: no-cache
/mesh/protocol.js
  Cache-Control: no-cache
/radio/index.html
  Cache-Control: no-cache
/radio/unlock.html
  Cache-Control: no-cache
/tle/stations.txt
  Cache-Control: no-cache
/tle/visual.txt
  Cache-Control: no-cache
/tle/weather.txt
  Cache-Control: no-cache

# --- Security baseline (added: no security headers were set) ---
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(self), bluetooth=(self), serial=(self), camera=(), microphone=(), payment=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'self'

# Cesium is a pinned vendor drop: never revalidated, ~30 MB of it.
# Was inheriting the Pages default; repeat visits refetched on every deploy.
/cesium/*
  Cache-Control: public, max-age=31536000, immutable
/mesh/three.min.js
  Cache-Control: public, max-age=31536000, immutable
/mesh/textures/*
  Cache-Control: public, max-age=31536000, immutable
