# --- Security baseline (added: no security headers were set) ---
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: geolocation=(self), bluetooth=(self), serial=(self), camera=(), microphone=(), payment=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'self'

# Cesium is a pinned vendor drop: never revalidated, ~30 MB of it.
# Was inheriting the Pages default; repeat visits refetched on every deploy.
/cesium/*
  Cache-Control: public, max-age=31536000, immutable
/mesh/three.min.js
  Cache-Control: public, max-age=31536000, immutable
/mesh/textures/*
  Cache-Control: public, max-age=31536000, immutable

# Last match wins. These in-place files must revalidate.
