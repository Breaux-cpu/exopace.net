# Cloudflare Pages — never let the CDN pin the SW or env past a deploy.
# moc-phone.css and the hashed MOC bundle are edited in place (no Vite
# rename). If they stay max-age=14400, leftover HUD fixes sit on origin
# while 390 still paints the old chips / credits / INSTALL overlap.
#
# Cache-Control rules that sit above the /* block lose to the Pages
# default (max-age=14400). Rules below it stick: /cesium/* is immutable
# on the wire, and /sw.js above this block is still max-age=14400.
# The no-cache list is repeated at the bottom so it wins.
/sw.js
  Cache-Control: no-cache
/mesh/sw.js
  Cache-Control: no-cache
/env.js
  Cache-Control: no-cache
/mesh/env.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/404.html
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache
/mesh/manifest.json
  Cache-Control: no-cache
/pwa-install.js
  Cache-Control: no-cache
/moc-phone.css
  Cache-Control: no-cache
/assets/index-B5yAHF7-.js
  Cache-Control: no-cache
/mesh/app.js
  Cache-Control: no-cache
/mesh/globe.js
  Cache-Control: no-cache
/mesh/store.js
  Cache-Control: no-cache
/mesh/index.html
  Cache-Control: no-cache
/mesh/protocol.js
  Cache-Control: no-cache
/radio/index.html
  Cache-Control: no-cache
/radio/unlock.html
  Cache-Control: no-cache
/exo-traffic.js
  Cache-Control: no-cache
/exo-weather.js
  Cache-Control: no-cache
/tle/stations.txt
  Cache-Control: no-cache
/tle/visual.txt
